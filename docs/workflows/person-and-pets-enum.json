{
  "title": "PersonAndPets",
  "$defs": {
    "Person": {
      "title": "Person",
      "type": "object",
      "properties": {
        "age": {
          "type": "integer"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Pet": {
      "title": "Pet",
      "type": "string",
      "enum": ["Dog", "Cat", "Fish", "Bird", "Reptile"]
    }
  },
  "type": "object",
  "properties": {
    "owner": {
      "$ref": "#/$defs/Person"
    },
    "pets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pet"
      }
    }
  }
}
